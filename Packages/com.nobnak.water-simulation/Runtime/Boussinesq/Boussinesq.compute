#pragma kernel CSInit
#pragma kernel CSPredict
#pragma kernel CSCorrect
#pragma kernel CSTridiagonalX
#pragma kernel CSTridiagonalZ
#pragma kernel CSApplyPredictedDispersion
#pragma kernel CSApplyDispersion
#pragma kernel CSAddImpulse
#pragma kernel CSComputeNormal
#pragma kernel CSFilterHighFrequency
#pragma kernel CSFilterX
#pragma kernel CSFilterZ
#pragma kernel CSDefectCorrection

RWTexture2D<float4> _StateIn;     // R: eta (surface elevation [m]), G: u (vel X [m/s]), B: w (vel Z [m/s]), A: aux
RWTexture2D<float4> _StatePred;   // Predicted state (MacCormack)
RWTexture2D<float4> _StateOut;    // Corrected / output state
Texture2D<float4> _BathymetryTex; // R: still water depth h [m], G: bed level z_b = -h [m]
RWTexture2D<float2> _ForceOrigTex;// RG: original non-dispersive acceleration f_orig (preserved across sweeps)
RWTexture2D<float2> _ForceTex;    // RG: RHS acceleration f = (fx, fz) at current sweep
RWTexture2D<float2> _ForcePredTex;// RG: dispersed predictor acceleration a^(1) = (ax^(1), az^(1))
RWTexture2D<float2> _AccelPing;   // RG: dispersed acceleration a = (ax, az)
RWTexture2D<float2> _AccelPong;   // RG: intermediate acceleration a*
RWTexture2D<float4> _NormalTex;   // RGB: geometric unit normal, A: foam
RWTexture2D<float4> _WaterDataTex;// RGB: displacement (0, eta, 0), A: foam

cbuffer SimParams {
    int _Width;
    int _Height;
    float _DeltaTime;
    float _GridSpacing;      // dx [m]
    float _GridSpacingZ;     // dz [m]
    float _Gravity;          // g = 9.81 [m/s^2]
    float _DispersionAlpha;  // 1.0 = Standard Peregrine (1967) Boussinesq (1/3 coeff), 0.0 = NSW
    float _BedFriction;      // Bottom friction
    float _SpongeWidth;      // Sponge width in cells
    float _SpongeStrength;
    int _StepParity;         // Alternating 0 / 1 for Symmetric MacCormack (F-B / B-F)
    int _SideWallSponge;     // 1 = Sponge on all 4 borders, 0 = Lateral reflective slip walls (flume)
};

cbuffer WavemakerParams {
    float _WavemakerAmp;     // Amplitude [m]
    float _WavemakerFreq;    // Frequency [Hz]
    float _WavemakerPhase;   // Phase [rad]
    int _WavemakerY;         // Grid line Y index where waves are generated
};

cbuffer ImpulseParams {
    float2 _ImpulseCenter;   // Normalized UV [0..1]
    float _ImpulseRadius;    // Normalized UV width / radius
    float _ImpulseStrength;  // Peak elevation amplitude [m]
    int _ImpulseShape;       // 0 = Planar Soliton (+Z propagation), 1 = Circular C^2 Pulse
};

#define MAX_TRIDIAG_N 512

groupshared float2 gs_a[MAX_TRIDIAG_N];
groupshared float2 gs_b[MAX_TRIDIAG_N];
groupshared float2 gs_c[MAX_TRIDIAG_N];
groupshared float2 gs_d[MAX_TRIDIAG_N];

float GetDx() {
    return max(1e-5, _GridSpacing);
}

float GetDz() {
    return (_GridSpacingZ > 1e-5) ? _GridSpacingZ : max(1e-5, _GridSpacing);
}

float SampleDepth(int2 pos) {
    int2 p = int2(clamp(pos.x, 0, _Width - 1), clamp(pos.y, 0, _Height - 1));
    return max(0.2, _BathymetryTex[p].r);
}

void GetWavemakerSources(int2 pos, float h, float phase, out float sourceEta, out float sourceW) {
    sourceEta = 0.0;
    sourceW = 0.0;
    if (_WavemakerAmp <= 0.001) return;

    float dy = (float)(pos.y - _WavemakerY);
    if (abs(dy) > 18.0) return;

    // Smooth lateral taper: if side wall sponge is enabled, taper near edges; otherwise keep full width for flat wave line
    float lateralTaper = 1.0;
    if (_SideWallSponge > 0) {
        float lateralDist = min((float)pos.x, (float)(_Width - 1 - pos.x));
        lateralTaper = smoothstep(0.0, _SpongeWidth * 1.5, lateralDist);
    }

    // Wei & Kirby (1999) internal mass source:
    // Wave of amplitude A propagating in +Z is generated by internal mass source S(y, t):
    // S(y, t) = 2 * c * A * sin(phase) * (1 / (sqrt(2*pi)*sigma)) * exp(-dy^2 / (2*sigma^2))
    // No velocity force is added to momentum (sourceW = 0), avoiding divergence shock and Helmholtz distortion.
    float dz = GetDz();
    float sigmaCells = 4.0;
    float invSqrt2PiSigma = 1.0 / (2.506628 * sigmaCells * dz);
    float gaussian = exp(-0.5 * (dy * dy) / (sigmaCells * sigmaCells));
    float c = sqrt(_Gravity * max(0.5, h));

    // Factor 2.0 accounts for the equal mass partition between +Z forward wave and -Z backward wave (absorbed by offshore sponge)
    sourceEta = 2.0 * c * _WavemakerAmp * sin(phase) * gaussian * invSqrt2PiSigma * lateralTaper;
    sourceW   = 0.0;
}

float ComputeSpongeDamping(int2 pos) {
    float distToBorder;
    if (_SideWallSponge > 0) {
        distToBorder = min(min((float)pos.x, (float)(_Width - 1 - pos.x)), min((float)pos.y, (float)(_Height - 1 - pos.y)));
    } else {
        distToBorder = min((float)pos.y, (float)(_Height - 1 - pos.y));
    }
    if (distToBorder < _SpongeWidth) {
        float t = 1.0 - (distToBorder / _SpongeWidth);
        return 1.0 / (1.0 + t * t * _SpongeStrength * _DeltaTime * 15.0);
    }
    return 1.0;
}

[numthreads(8, 8, 1)]
void CSInit(uint3 id : SV_DispatchThreadID) {
    if (id.x >= (uint)_Width || id.y >= (uint)_Height) return;
    _StateOut[id.xy] = float4(0.0, 0.0, 0.0, 0.0);
    _NormalTex[id.xy] = float4(0.0, 1.0, 0.0, 0.0);
    _WaterDataTex[id.xy] = float4(0.0, 0.0, 0.0, 0.0);
    _ForceOrigTex[id.xy] = float2(0.0, 0.0);
    _ForceTex[id.xy] = float2(0.0, 0.0);
    _ForcePredTex[id.xy] = float2(0.0, 0.0);
    _AccelPing[id.xy] = float2(0.0, 0.0);
    _AccelPong[id.xy] = float2(0.0, 0.0);
}

// Smooth C^1 approximation of max(0.05, totalDepth) to avoid derivative discontinuities
float SmoothTotalDepth(float rawH) {
    float d = rawH - 0.05;
    return 0.05 + 0.5 * (d + sqrt(d * d + 0.0004));
}

// 1. Symmetric MacCormack Predictor: Forward on even parity, Backward on odd parity
[numthreads(8, 8, 1)]
void CSPredict(uint3 id : SV_DispatchThreadID) {
    if (id.x >= (uint)_Width || id.y >= (uint)_Height) return;
    int2 pos = int2(id.xy);

    int dir = (_StepParity == 0) ? 1 : -1;
    int2 posX = int2(clamp(pos.x + dir, 0, _Width - 1), pos.y);
    int2 posZ = int2(pos.x, clamp(pos.y + dir, 0, _Height - 1));

    float4 stateC = _StateIn[pos];
    float4 stateX = _StateIn[posX];
    float4 stateZ = _StateIn[posZ];

    float eta = stateC.r;
    float u   = stateC.g;
    float w   = stateC.b;

    float hC = SampleDepth(pos);
    float hX = SampleDepth(posX);
    float hZ = SampleDepth(posZ);

    float totalHC = SmoothTotalDepth(hC + eta);
    float totalHX = SmoothTotalDepth(hX + stateX.r);
    float totalHZ = SmoothTotalDepth(hZ + stateZ.r);

    float signedInvDx = (float)dir / GetDx();
    float signedInvDz = (float)dir / GetDz();

    // Flux divergence: d(Hu)/dx + d(Hw)/dz
    float dHudx = (totalHX * stateX.g - totalHC * u) * signedInvDx;
    float dHwdz = (totalHZ * stateZ.b - totalHC * w) * signedInvDz;

    // Directional mass and momentum source
    float srcEta, srcW;
    GetWavemakerSources(pos, hC, _WavemakerPhase, srcEta, srcW);

    float etaPred = eta - _DeltaTime * (dHudx + dHwdz) + _DeltaTime * srcEta;

    // Spatial derivatives for momentum:
    float detadx = (stateX.r - eta) * signedInvDx;
    float detadz = (stateZ.r - eta) * signedInvDz;

    float dudx = (stateX.g - u) * signedInvDx;
    float dudz = (stateZ.g - u) * signedInvDz;
    float dwdx = (stateX.b - w) * signedInvDx;
    float dwdz = (stateZ.b - w) * signedInvDz;

    float advectX = u * dudx + w * dudz;
    float advectZ = u * dwdx + w * dwdz;

    float friction = _BedFriction / totalHC;

    float fx = -_Gravity * detadx - advectX - friction * u;
    float fz = -_Gravity * detadz - advectZ - friction * w;

    _ForceOrigTex[pos] = float2(fx, fz);
    _ForceTex[pos] = float2(fx, fz);
    _AccelPing[pos] = float2(fx, fz);

    if (_DispersionAlpha <= 0.001) {
        float damp = ComputeSpongeDamping(pos);
        etaPred = clamp(etaPred * damp, -15.0, 15.0);
        float uPred = clamp((u + _DeltaTime * fx) * damp, -30.0, 30.0);
        float wPred = clamp((w + _DeltaTime * fz) * damp, -30.0, 30.0);
        if (_SideWallSponge == 0 && (pos.x == 0 || pos.x == _Width - 1)) uPred = 0.0;
        if (pos.y == 0 || pos.y == _Height - 1) wPred = 0.0;
        _StatePred[pos] = float4(etaPred, uPred, wPred, 0.0);
    } else {
        // Store un-damped etaPred and current (u, w); CSApplyPredictedDispersion will finalize uPred, wPred and damp
        _StatePred[pos] = float4(etaPred, u, w, 0.0);
    }
}

// 1b. Finalize Predictor state after solving Peregrine dispersion for a^(1) = L^{-1}(f^n)
[numthreads(8, 8, 1)]
void CSApplyPredictedDispersion(uint3 id : SV_DispatchThreadID) {
    if (id.x >= (uint)_Width || id.y >= (uint)_Height) return;
    int2 pos = int2(id.xy);

    float4 state = _StatePred[pos];
    float etaPred = state.r;
    float uN = state.g;
    float wN = state.b;

    float2 a1 = _AccelPing[pos];
    _ForcePredTex[pos] = a1;

    float damp = ComputeSpongeDamping(pos);
    etaPred = clamp(etaPred * damp, -15.0, 15.0);
    float uPred = clamp((uN + _DeltaTime * a1.x) * damp, -30.0, 30.0);
    float wPred = clamp((wN + _DeltaTime * a1.y) * damp, -30.0, 30.0);

    _StatePred[pos] = float4(etaPred, uPred, wPred, 0.0);
}

// 2. Symmetric MacCormack Corrector: Opposite spatial difference on predicted state
[numthreads(8, 8, 1)]
void CSCorrect(uint3 id : SV_DispatchThreadID) {
    if (id.x >= (uint)_Width || id.y >= (uint)_Height) return;
    int2 pos = int2(id.xy);

    int dir = (_StepParity == 0) ? -1 : 1;
    int2 posX = int2(clamp(pos.x + dir, 0, _Width - 1), pos.y);
    int2 posZ = int2(pos.x, clamp(pos.y + dir, 0, _Height - 1));

    float4 stateN = _StateIn[pos];
    float4 statePredC = _StatePred[pos];
    float4 statePredX = _StatePred[posX];
    float4 statePredZ = _StatePred[posZ];

    float etaStar = statePredC.r;
    float uStar   = statePredC.g;
    float wStar   = statePredC.b;

    float hC = SampleDepth(pos);
    float hX = SampleDepth(posX);
    float hZ = SampleDepth(posZ);

    float totalHC = SmoothTotalDepth(hC + etaStar);
    float totalHX = SmoothTotalDepth(hX + statePredX.r);
    float totalHZ = SmoothTotalDepth(hZ + statePredZ.r);

    float signedInvDx = (float)dir / GetDx();
    float signedInvDz = (float)dir / GetDz();

    // Opposite flux divergence on predicted state:
    float dHudxStar = (totalHX * statePredX.g - totalHC * uStar) * signedInvDx;
    float dHwdzStar = (totalHZ * statePredZ.b - totalHC * wStar) * signedInvDz;

    float nextPhase = _WavemakerPhase + 2.0 * 3.14159265 * _WavemakerFreq * _DeltaTime;
    float srcEtaStar, srcWStar;
    GetWavemakerSources(pos, hC, nextPhase, srcEtaStar, srcWStar);

    // MacCormack 2nd-order elevation update
    float etaNext = 0.5 * (stateN.r + etaStar - _DeltaTime * (dHudxStar + dHwdzStar) + _DeltaTime * srcEtaStar);

    // Spatial derivatives for momentum on predicted state:
    float detadxStar = (statePredX.r - etaStar) * signedInvDx;
    float detadzStar = (statePredZ.r - etaStar) * signedInvDz;

    float dudxStar = (statePredX.g - uStar) * signedInvDx;
    float dudzStar = (statePredZ.g - uStar) * signedInvDz;
    float dwdxStar = (statePredX.b - wStar) * signedInvDx;
    float dwdzStar = (statePredZ.b - wStar) * signedInvDz;

    float advectXStar = uStar * dudxStar + wStar * dudzStar;
    float advectZStar = uStar * dwdxStar + wStar * dwdzStar;

    float frictionStar = _BedFriction / totalHC;

    float fxStar = -_Gravity * detadxStar - advectXStar - frictionStar * uStar;
    float fzStar = -_Gravity * detadzStar - advectZStar - frictionStar * wStar;

    float damp = ComputeSpongeDamping(pos);
    etaNext = clamp(etaNext * damp, -15.0, 15.0);

    if (_DispersionAlpha <= 0.001) {
        float uNext = clamp(0.5 * (stateN.g + uStar + _DeltaTime * fxStar) * damp, -30.0, 30.0);
        float wNext = clamp(0.5 * (stateN.b + wStar + _DeltaTime * fzStar) * damp, -30.0, 30.0);
        if (_SideWallSponge == 0 && (pos.x == 0 || pos.x == _Width - 1)) uNext = 0.0;
        if (pos.y == 0 || pos.y == _Height - 1) wNext = 0.0;
        _StateOut[pos] = float4(etaNext, uNext, wNext, 0.0);
    } else {
        // Store corrector RHS f* = (fxStar, fzStar) in _ForceOrigTex and _ForceTex
        float2 fStar = float2(fxStar, fzStar);
        _ForceOrigTex[pos] = fStar;
        _ForceTex[pos] = fStar;
        _StateOut[pos] = float4(etaNext, stateN.g, stateN.b, 0.0);
    }
}

// 3a. ADI Tridiagonal Parallel Cyclic Reduction (PCR) along X for Peregrine momentum dispersion:
// Solves (I - beta_x d_x^2) a* = f with decoupled normal (Dirichlet) and tangential (Neumann) boundary rows.
[numthreads(MAX_TRIDIAG_N, 1, 1)]
void CSTridiagonalX(uint3 gtid : SV_GroupThreadID, uint3 gid : SV_GroupID) {
    uint i = gtid.x;
    uint j = gid.x;
    uint W = (uint)_Width;
    uint H = (uint)_Height;

    float2 a = float2(0.0, 0.0);
    float2 b = float2(1.0, 1.0);
    float2 c = float2(0.0, 0.0);
    float2 d = float2(0.0, 0.0);

    if (i < W && j < H) {
        int2 pos = int2(i, j);
        if (j == 0u || j == H - 1u) {
            d = float2(0.0, 0.0);
        } else if (i == 0u || i == W - 1u) {
            if (_SideWallSponge > 0) {
                d = float2(0.0, 0.0);
            } else {
                // Slip flume wall:
                // Normal component (x / ax): strict Dirichlet condition ax = 0 (row: 1 * ax = 0)
                // Tangential component (y / az): strict Neumann condition d(az)/dx = 0
                float hC  = SampleDepth(pos);
                float dx  = GetDx();
                float invDx2 = _DispersionAlpha / (dx * dx);
                float beta = invDx2 * ((1.0 / 3.0) * hC * hC);

                float2 fVal = _ForceTex[pos];
                if (i == 0u) {
                    a = float2(0.0, 0.0);
                    b = float2(1.0, 1.0 + 2.0 * beta);
                    c = float2(0.0, -2.0 * beta);
                    d = float2(0.0, fVal.y);
                } else {
                    a = float2(0.0, -2.0 * beta);
                    b = float2(1.0, 1.0 + 2.0 * beta);
                    c = float2(0.0, 0.0);
                    d = float2(0.0, fVal.y);
                }
            }
        } else {
            float hC  = SampleDepth(pos);
            float hL  = SampleDepth(pos + int2(-1, 0));
            float hR  = SampleDepth(pos + int2( 1, 0));
            float dx  = GetDx();
            float invDx2 = _DispersionAlpha / (dx * dx);

            // Peregrine 1/3 coefficient: in flat depth, a = c = -alpha * h^2 / (3 * dx^2), b = 1 + 2 * alpha * h^2 / (3 * dx^2)
            float aVal = -invDx2 * (0.5 * hC * hL - (hC * hC) / 6.0);
            float bVal = 1.0 + invDx2 * ((2.0 / 3.0) * hC * hC);
            float cVal = -invDx2 * (0.5 * hC * hR - (hC * hC) / 6.0);

            a = float2(aVal, aVal);
            b = float2(bVal, bVal);
            c = float2(cVal, cVal);
            d = _ForceTex[pos];
        }
    }

    gs_a[i] = a;
    gs_b[i] = b;
    gs_c[i] = c;
    gs_d[i] = d;
    GroupMemoryBarrierWithGroupSync();

    // Parallel Cyclic Reduction (9 steps for MAX_TRIDIAG_N = 512)
    [unroll]
    for (uint s = 0u; s < 9u; s++) {
        uint stride = 1u << s;
        float2 aNew = a;
        float2 bNew = b;
        float2 cNew = c;
        float2 dNew = d;

        if (i < W) {
            float2 k1 = float2(0.0, 0.0);
            float2 cL = float2(0.0, 0.0);
            float2 dL = float2(0.0, 0.0);
            if (i >= stride) {
                uint idxL = i - stride;
                k1 = a / max(1e-8, gs_b[idxL]);
                cL = gs_c[idxL];
                dL = gs_d[idxL];
                aNew = -k1 * gs_a[idxL];
            } else {
                aNew = float2(0.0, 0.0);
            }

            float2 k2 = float2(0.0, 0.0);
            float2 aR = float2(0.0, 0.0);
            float2 dR = float2(0.0, 0.0);
            if (i + stride < W) {
                uint idxR = i + stride;
                k2 = c / max(1e-8, gs_b[idxR]);
                aR = gs_a[idxR];
                dR = gs_d[idxR];
                cNew = -k2 * gs_c[idxR];
            } else {
                cNew = float2(0.0, 0.0);
            }

            bNew = b - k1 * cL - k2 * aR;
            dNew = d - k1 * dL - k2 * dR;
        }

        GroupMemoryBarrierWithGroupSync();
        a = aNew;
        b = bNew;
        c = cNew;
        d = dNew;
        gs_a[i] = a;
        gs_b[i] = b;
        gs_c[i] = c;
        gs_d[i] = d;
        GroupMemoryBarrierWithGroupSync();
    }

    if (i < W && j < H) {
        int2 pos = int2(i, j);
        float2 aStar = d / max(1e-8, b);
        if (_SideWallSponge == 0 && (i == 0u || i == W - 1u)) {
            aStar.x = 0.0; // Strictly zero normal acceleration at solid lateral walls
        }
        _AccelPong[pos] = aStar;
    }
}

// 3b. ADI Tridiagonal Parallel Cyclic Reduction (PCR) along Z for Peregrine momentum dispersion:
// Solves (I - beta_z d_z^2) a = a* with decoupled normal (Dirichlet) and tangential (Neumann) boundary rows.
[numthreads(MAX_TRIDIAG_N, 1, 1)]
void CSTridiagonalZ(uint3 gtid : SV_GroupThreadID, uint3 gid : SV_GroupID) {
    uint j = gtid.x;
    uint i = gid.x;
    uint W = (uint)_Width;
    uint H = (uint)_Height;

    float2 a = float2(0.0, 0.0);
    float2 b = float2(1.0, 1.0);
    float2 c = float2(0.0, 0.0);
    float2 d = float2(0.0, 0.0);

    if (i < W && j < H) {
        int2 pos = int2(i, j);
        if (j == 0u || j == H - 1u) {
            // Offshore / beach border:
            // Normal component (y / az): strict Dirichlet condition az = 0
            // Tangential component (x / ax): Neumann condition d(ax)/dz = 0
            float hC  = SampleDepth(pos);
            float dz  = GetDz();
            float invDz2 = _DispersionAlpha / (dz * dz);
            float beta = invDz2 * ((1.0 / 3.0) * hC * hC);

            float2 fVal = _AccelPong[pos];
            if (j == 0u) {
                a = float2(0.0, 0.0);
                b = float2(1.0 + 2.0 * beta, 1.0);
                c = float2(-2.0 * beta, 0.0);
                d = float2(fVal.x, 0.0);
            } else {
                a = float2(-2.0 * beta, 0.0);
                b = float2(1.0 + 2.0 * beta, 1.0);
                c = float2(0.0, 0.0);
                d = float2(fVal.x, 0.0);
            }
        } else if ((i == 0u || i == W - 1u) && _SideWallSponge > 0) {
            d = float2(0.0, 0.0);
        } else {
            float hC  = SampleDepth(pos);
            float hD  = SampleDepth(pos + int2(0, -1));
            float hU  = SampleDepth(pos + int2(0,  1));
            float dz  = GetDz();
            float invDz2 = _DispersionAlpha / (dz * dz);

            float aVal = -invDz2 * (0.5 * hC * hD - (hC * hC) / 6.0);
            float bVal = 1.0 + invDz2 * ((2.0 / 3.0) * hC * hC);
            float cVal = -invDz2 * (0.5 * hC * hU - (hC * hC) / 6.0);

            a = float2(aVal, aVal);
            b = float2(bVal, bVal);
            c = float2(cVal, cVal);
            d = _AccelPong[pos];
        }
    }

    gs_a[j] = a;
    gs_b[j] = b;
    gs_c[j] = c;
    gs_d[j] = d;
    GroupMemoryBarrierWithGroupSync();

    [unroll]
    for (uint s = 0u; s < 9u; s++) {
        uint stride = 1u << s;
        float2 aNew = a;
        float2 bNew = b;
        float2 cNew = c;
        float2 dNew = d;

        if (j < H) {
            float2 k1 = float2(0.0, 0.0);
            float2 cL = float2(0.0, 0.0);
            float2 dL = float2(0.0, 0.0);
            if (j >= stride) {
                uint idxL = j - stride;
                k1 = a / max(1e-8, gs_b[idxL]);
                cL = gs_c[idxL];
                dL = gs_d[idxL];
                aNew = -k1 * gs_a[idxL];
            } else {
                aNew = float2(0.0, 0.0);
            }

            float2 k2 = float2(0.0, 0.0);
            float2 aR = float2(0.0, 0.0);
            float2 dR = float2(0.0, 0.0);
            if (j + stride < H) {
                uint idxR = j + stride;
                k2 = c / max(1e-8, gs_b[idxR]);
                aR = gs_a[idxR];
                dR = gs_d[idxR];
                cNew = -k2 * gs_c[idxR];
            } else {
                cNew = float2(0.0, 0.0);
            }

            bNew = b - k1 * cL - k2 * aR;
            dNew = d - k1 * dL - k2 * dR;
        }

        GroupMemoryBarrierWithGroupSync();
        a = aNew;
        b = bNew;
        c = cNew;
        d = dNew;
        gs_a[j] = a;
        gs_b[j] = b;
        gs_c[j] = c;
        gs_d[j] = d;
        GroupMemoryBarrierWithGroupSync();
    }

    if (i < W && j < H) {
        int2 pos = int2(i, j);
        float2 aFinal = d / max(1e-8, b);
        if (_SideWallSponge == 0 && (i == 0u || i == W - 1u)) {
            aFinal.x = 0.0; // Strictly zero normal acceleration at solid lateral walls
        }
        if (j == 0u || j == H - 1u) {
            aFinal.y = 0.0; // Strictly zero normal acceleration at offshore/beach borders
        }
        _AccelPing[pos] = aFinal;
    }
}

// 4. Apply 2nd-order Heun/MacCormack dispersed acceleration 0.5*(a^(1) + a^(2)) to velocity and apply sponge layer
[numthreads(8, 8, 1)]
void CSApplyDispersion(uint3 id : SV_DispatchThreadID) {
    if (id.x >= (uint)_Width || id.y >= (uint)_Height) return;
    int2 pos = int2(id.xy);

    float4 state = _StateIn[pos];
    float eta = state.r;
    float uN  = state.g;
    float wN  = state.b;

    float2 a1 = _ForcePredTex[pos];
    float2 a2 = _AccelPing[pos];
    float2 aAvg = 0.5 * (a1 + a2);

    float uNext = uN + _DeltaTime * aAvg.x;
    float wNext = wN + _DeltaTime * aAvg.y;

    float damp = ComputeSpongeDamping(pos);
    uNext *= damp;
    wNext *= damp;

    if (_SideWallSponge == 0 && (pos.x == 0 || pos.x == _Width - 1)) {
        uNext = 0.0; // Impermeable solid wall condition: zero normal velocity
    }
    if (pos.y == 0 || pos.y == _Height - 1) {
        wNext = 0.0; // Impermeable solid border condition: zero normal velocity
    }

    uNext = clamp(uNext, -30.0, 30.0);
    wNext = clamp(wNext, -30.0, 30.0);

    _StateOut[pos] = float4(eta, uNext, wNext, 0.0);
}

// 5. Non-destructive GPU impulse / soliton injection
[numthreads(8, 8, 1)]
void CSAddImpulse(uint3 id : SV_DispatchThreadID) {
    if (id.x >= (uint)_Width || id.y >= (uint)_Height) return;
    int2 pos = int2(id.xy);

    float2 uv = (float2(pos) + 0.5) / float2(_Width, _Height);
    float h = max(0.5, _BathymetryTex[pos].r);
    float4 state = _StateOut[pos];

    if (_ImpulseShape == 0) {
        // Planar solitary wave propagating in +Z (along +Y in grid)
        float dy = abs(uv.y - _ImpulseCenter.y);
        float width = max(0.01, _ImpulseRadius);
        if (dy < width * 3.0) {
            float lateralTaper = 1.0;
            if (_SideWallSponge > 0) {
                float lateralDist = min((float)pos.x, (float)(_Width - 1 - pos.x));
                lateralTaper = smoothstep(0.0, _SpongeWidth * 1.5, lateralDist);
            }

            float arg = clamp((uv.y - _ImpulseCenter.y) / (width * 0.6), -8.0, 8.0);
            float coshVal = 0.5 * (exp(arg) + exp(-arg));
            float sech2 = 1.0 / (coshVal * coshVal);

            float dEta = _ImpulseStrength * sech2 * lateralTaper;
            float c = sqrt(_Gravity * (h + max(0.0, dEta)));
            float dW = c * dEta / (h + max(0.0, dEta));

            state.r = clamp(state.r + dEta, -15.0, 15.0);
            state.b = clamp(state.b + dW, -30.0, 30.0);
            if (_SideWallSponge == 0 && (pos.x == 0 || pos.x == _Width - 1)) state.g = 0.0;
            if (pos.y == 0 || pos.y == _Height - 1) state.b = 0.0;
            _StateOut[pos] = state;
        }
    } else {
        // Circular C^2-continuous compactly supported polynomial bell (matches WaveEquation CSAddImpulse)
        float d = distance(uv, _ImpulseCenter);
        float radius = max(1e-4, _ImpulseRadius);
        if (d < radius) {
            float rNorm = d / radius;
            float q = max(0.0, 1.0 - rNorm * rNorm);
            float dEta = _ImpulseStrength * (q * q * q);
            state.r = clamp(state.r + dEta, -15.0, 15.0);
            if (_SideWallSponge == 0 && (pos.x == 0 || pos.x == _Width - 1)) state.g = 0.0;
            if (pos.y == 0 || pos.y == _Height - 1) state.b = 0.0;
            _StateOut[pos] = state;
        }
    }
}

// 6. Surface normal and foam computation
[numthreads(8, 8, 1)]
void CSComputeNormal(uint3 id : SV_DispatchThreadID) {
    if (id.x >= (uint)_Width || id.y >= (uint)_Height) return;
    int2 pos = int2(id.xy);

    int l = max(0, pos.x - 1);
    int r = min(_Width - 1, pos.x + 1);
    int d = max(0, pos.y - 1);
    int u = min(_Height - 1, pos.y + 1);

    float hL = _StateOut[int2(l, pos.y)].r;
    float hR = _StateOut[int2(r, pos.y)].r;
    float hD = _StateOut[int2(pos.x, d)].r;
    float hU = _StateOut[int2(pos.x, u)].r;
    float hC = _StateOut[pos].r;

    float dx = 2.0 * GetDx();
    float dz = 2.0 * GetDz();
    float dhdx = (hR - hL) / dx;
    float dhdz = (hU - hD) / dz;

    // Store true geometric unit normal N = normalize(-dh/dx, 1, -dh/dz)
    float3 normal = normalize(float3(-dhdx, 1.0, -dhdz));

    float slope = length(float2(dhdx, dhdz));
    float foam = saturate((slope - 0.15) * 3.0);

    _NormalTex[pos] = float4(normal, foam);
    _WaterDataTex[pos] = float4(0.0, hC, 0.0, foam);
}

// 7. 4th-order biharmonic spatial filter with exact mass conservation and dt-scaled damping
[numthreads(8, 8, 1)]
void CSFilterHighFrequency(uint3 id : SV_DispatchThreadID) {
    if (id.x >= (uint)_Width || id.y >= (uint)_Height) return;
    int2 pos = int2(id.xy);

    float4 c = _StateIn[pos];

    int x = pos.x;
    int y = pos.y;
    int w = _Width;
    int h = _Height;

    // Conservative zero-flux 4th-order spatial difference along X:
    // Ensures sum_{x=0}^{W-1} d4x == 0 identically (exact machine-precision mass conservation)
    float4 d4x;
    if (x == 0) {
        d4x = 2.0 * _StateIn[int2(0, y)] - 3.0 * _StateIn[int2(1, y)] + _StateIn[int2(2, y)];
    } else if (x == 1) {
        d4x = -3.0 * _StateIn[int2(0, y)] + 6.0 * _StateIn[int2(1, y)] - 4.0 * _StateIn[int2(2, y)] + _StateIn[int2(3, y)];
    } else if (x == w - 2) {
        d4x = _StateIn[int2(w - 4, y)] - 4.0 * _StateIn[int2(w - 3, y)] + 6.0 * _StateIn[int2(w - 2, y)] - 3.0 * _StateIn[int2(w - 1, y)];
    } else if (x == w - 1) {
        d4x = _StateIn[int2(w - 3, y)] - 3.0 * _StateIn[int2(w - 2, y)] + 2.0 * _StateIn[int2(w - 1, y)];
    } else {
        d4x = _StateIn[int2(x - 2, y)] - 4.0 * _StateIn[int2(x - 1, y)] + 6.0 * c - 4.0 * _StateIn[int2(x + 1, y)] + _StateIn[int2(x + 2, y)];
    }

    // Conservative zero-flux 4th-order spatial difference along Z:
    float4 d4z;
    if (y == 0) {
        d4z = 2.0 * _StateIn[int2(x, 0)] - 3.0 * _StateIn[int2(x, 1)] + _StateIn[int2(x, 2)];
    } else if (y == 1) {
        d4z = -3.0 * _StateIn[int2(x, 0)] + 6.0 * _StateIn[int2(x, 1)] - 4.0 * _StateIn[int2(x, 2)] + _StateIn[int2(x, 3)];
    } else if (y == h - 2) {
        d4z = _StateIn[int2(x, h - 4)] - 4.0 * _StateIn[int2(x, h - 3)] + 6.0 * _StateIn[int2(x, h - 2)] - 3.0 * _StateIn[int2(x, h - 1)];
    } else if (y == h - 1) {
        d4z = _StateIn[int2(x, h - 3)] - 3.0 * _StateIn[int2(x, h - 2)] + 2.0 * _StateIn[int2(x, h - 1)];
    } else {
        d4z = _StateIn[int2(x, y - 2)] - 4.0 * _StateIn[int2(x, y - 1)] + 6.0 * c - 4.0 * _StateIn[int2(x, y + 1)] + _StateIn[int2(x, y + 2)];
    }

    // Time-step invariant 4th-order biharmonic dissipation:
    // Dissipation rate per unit physical time is constant across any sub-step dt:
    // kappa / dt = 5.0 s^-1 is constant across all time-steps without arbitrary lower clamp.
    // Respects explicit 2D biharmonic stability limit (kappa <= 0.03125).
    float kappa = min(0.031, 5.0 * _DeltaTime);
    float4 filtered = c - kappa * (d4x + d4z);

    if (_SideWallSponge == 0 && (x == 0 || x == w - 1)) {
        filtered.g = 0.0; // Strictly zero normal velocity on lateral solid walls
    }
    if (y == 0 || y == h - 1) {
        filtered.b = 0.0; // Strictly zero normal velocity on offshore/beach borders
    }

    filtered.r = clamp(filtered.r, -15.0, 15.0);
    filtered.g = clamp(filtered.g, -30.0, 30.0);
    filtered.b = clamp(filtered.b, -30.0, 30.0);
    filtered.a = 0.0;

    _StateOut[pos] = filtered;
}

// 7b. Directional-split 4th-order biharmonic filter: Pass 1 along X
// Eliminates 2dx along-crest corrugations with explicit 1D biharmonic stability limit (kappaX <= 1/16 = 0.0625)
[numthreads(8, 8, 1)]
void CSFilterX(uint3 id : SV_DispatchThreadID) {
    if (id.x >= (uint)_Width || id.y >= (uint)_Height) return;
    int2 pos = int2(id.xy);
    float4 c = _StateIn[pos];
    int x = pos.x;
    int y = pos.y;
    int w = _Width;

    float4 d4x;
    if (x == 0) {
        d4x = 2.0 * _StateIn[int2(0, y)] - 3.0 * _StateIn[int2(1, y)] + _StateIn[int2(2, y)];
    } else if (x == 1) {
        d4x = -3.0 * _StateIn[int2(0, y)] + 6.0 * _StateIn[int2(1, y)] - 4.0 * _StateIn[int2(2, y)] + _StateIn[int2(3, y)];
    } else if (x == w - 2) {
        d4x = _StateIn[int2(w - 4, y)] - 4.0 * _StateIn[int2(w - 3, y)] + 6.0 * _StateIn[int2(w - 2, y)] - 3.0 * _StateIn[int2(w - 1, y)];
    } else if (x == w - 1) {
        d4x = _StateIn[int2(w - 3, y)] - 3.0 * _StateIn[int2(w - 2, y)] + 2.0 * _StateIn[int2(w - 1, y)];
    } else {
        d4x = _StateIn[int2(x - 2, y)] - 4.0 * _StateIn[int2(x - 1, y)] + 6.0 * c - 4.0 * _StateIn[int2(x + 1, y)] + _StateIn[int2(x + 2, y)];
    }

    float kappaX = min(0.058, 12.0 * _DeltaTime);
    float4 filtered = c - kappaX * d4x;

    if (_SideWallSponge == 0 && (x == 0 || x == w - 1)) {
        filtered.g = 0.0; // Strictly zero normal velocity on lateral solid walls
    }

    filtered.r = clamp(filtered.r, -15.0, 15.0);
    filtered.g = clamp(filtered.g, -30.0, 30.0);
    filtered.b = clamp(filtered.b, -30.0, 30.0);
    filtered.a = 0.0;

    _StateOut[pos] = filtered;
}

// 7c. Directional-split 4th-order biharmonic filter: Pass 2 along Z
[numthreads(8, 8, 1)]
void CSFilterZ(uint3 id : SV_DispatchThreadID) {
    if (id.x >= (uint)_Width || id.y >= (uint)_Height) return;
    int2 pos = int2(id.xy);
    float4 c = _StateIn[pos];
    int x = pos.x;
    int y = pos.y;
    int h = _Height;

    float4 d4z;
    if (y == 0) {
        d4z = 2.0 * _StateIn[int2(x, 0)] - 3.0 * _StateIn[int2(x, 1)] + _StateIn[int2(x, 2)];
    } else if (y == 1) {
        d4z = -3.0 * _StateIn[int2(x, 0)] + 6.0 * _StateIn[int2(x, 1)] - 4.0 * _StateIn[int2(x, 2)] + _StateIn[int2(x, 3)];
    } else if (y == h - 2) {
        d4z = _StateIn[int2(x, h - 4)] - 4.0 * _StateIn[int2(x, h - 3)] + 6.0 * _StateIn[int2(x, h - 2)] - 3.0 * _StateIn[int2(x, h - 1)];
    } else if (y == h - 1) {
        d4z = _StateIn[int2(x, h - 3)] - 3.0 * _StateIn[int2(x, h - 2)] + 2.0 * _StateIn[int2(x, h - 1)];
    } else {
        d4z = _StateIn[int2(x, y - 2)] - 4.0 * _StateIn[int2(x, y - 1)] + 6.0 * c - 4.0 * _StateIn[int2(x, y + 1)] + _StateIn[int2(x, y + 2)];
    }

    float kappaZ = min(0.058, 12.0 * _DeltaTime);
    float4 filtered = c - kappaZ * d4z;

    if (y == 0 || y == h - 1) {
        filtered.b = 0.0; // Strictly zero normal velocity on offshore/beach borders
    }

    filtered.r = clamp(filtered.r, -15.0, 15.0);
    filtered.g = clamp(filtered.g, -30.0, 30.0);
    filtered.b = clamp(filtered.b, -30.0, 30.0);
    filtered.a = 0.0;

    _StateOut[pos] = filtered;
}

// 8. ADI Defect correction for dispersionSweeps > 1:
// Calculates cross-derivative defect (beta_x * beta_z * d_x^2 d_z^2 a) and sets _ForceTex = _ForceOrigTex + defect
[numthreads(8, 8, 1)]
void CSDefectCorrection(uint3 id : SV_DispatchThreadID) {
    if (id.x >= (uint)_Width || id.y >= (uint)_Height) return;
    int2 pos = int2(id.xy);

    int l = max(0, pos.x - 1);
    int r = min(_Width - 1, pos.x + 1);
    int d = max(0, pos.y - 1);
    int u = min(_Height - 1, pos.y + 1);

    float2 aC  = _AccelPing[pos];
    float2 aL  = _AccelPing[int2(l, pos.y)];
    float2 aR  = _AccelPing[int2(r, pos.y)];
    float2 aD  = _AccelPing[int2(pos.x, d)];
    float2 aU  = _AccelPing[int2(pos.x, u)];
    float2 aLD = _AccelPing[int2(l, d)];
    float2 aRD = _AccelPing[int2(r, d)];
    float2 aLU = _AccelPing[int2(l, u)];
    float2 aRU = _AccelPing[int2(r, u)];

    float dx = GetDx();
    float dz = GetDz();
    float hC = SampleDepth(pos);

    float betaX = _DispersionAlpha * (hC * hC) / (3.0 * dx * dx);
    float betaZ = _DispersionAlpha * (hC * hC) / (3.0 * dz * dz);

    float2 d2zC = aU - 2.0 * aC + aD;
    float2 d2zL = aLU - 2.0 * aL + aLD;
    float2 d2zR = aRU - 2.0 * aR + aRD;
    float2 crossD4 = d2zR - 2.0 * d2zC + d2zL;

    float2 defect = betaX * betaZ * crossD4;
    _ForceTex[pos] = _ForceOrigTex[pos] + defect;
}
