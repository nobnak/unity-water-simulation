#pragma kernel CSInit
#pragma kernel CSPredict
#pragma kernel CSCorrect
#pragma kernel CSJacobiStep
#pragma kernel CSApplyDispersion
#pragma kernel CSComputeNormal

RWTexture2D<float4> _StateIn;     // R: eta (surface elevation), G: u (vel X), B: w (vel Z), A: aux
RWTexture2D<float4> _StatePred;   // Predicted state (MacCormack)
RWTexture2D<float4> _StateOut;    // Corrected / output state
Texture2D<float4> _BathymetryTex; // R: water depth h [m], G: bed level z_b [m], B: sponge mask
RWTexture2D<float4> _ForceTex;    // RG: rhs force (fx, fz)
RWTexture2D<float4> _AccelPing;   // RG: acceleration a_x, a_z
RWTexture2D<float4> _AccelPong;
RWTexture2D<float4> _NormalTex;   // RGB: normal, A: foam
RWTexture2D<float4> _WaterDataTex; // RGB: displacement (0, eta, 0), A: foam

cbuffer SimParams {
    int _Width;
    int _Height;
    float _DeltaTime;
    float _GridSpacing;      // dx [m]
    float _Gravity;          // g = 9.81 [m/s^2]
    float _DispersionAlpha;  // 1.0 = Boussinesq, 0.0 = Nonlinear Shallow Water
    float _BedFriction;      // Bottom friction
    float _SpongeWidth;      // Cells
    float _SpongeStrength;
};

cbuffer WavemakerParams {
    float _WavemakerAmp;     // Amplitude [m]
    float _WavemakerFreq;    // Frequency [Hz]
    float _WavemakerPhase;   // Phase [rad]
    int _WavemakerY;         // Grid line Y index where waves are generated
};

void GetWavemakerSources(int2 pos, float h, float phase, out float sourceEta, out float sourceW) {
    sourceEta = 0.0;
    sourceW = 0.0;
    if (_WavemakerAmp <= 0.001) return;

    float dy = (float)(pos.y - _WavemakerY);
    if (abs(dy) > 10.0) return;

    // Smooth lateral taper to avoid pumping wave energy directly into the side sponge absorption layers
    float lateralDist = min((float)pos.x, (float)(_Width - 1 - pos.x));
    float lateralTaper = smoothstep(0.0, _SpongeWidth * 1.5, lateralDist);

    // Directional progressive wavemaker (pure +Z propagation via characteristic synthesis)
    float sigmaCells = 2.5;
    float invSqrt2PiSigma = 1.0 / (2.506628 * sigmaCells * _GridSpacing);
    float gaussian = exp(-0.5 * (dy * dy) / (sigmaCells * sigmaCells));
    float c = sqrt(_Gravity * max(0.5, h));

    float waveSig = _WavemakerAmp * sin(phase) * gaussian * invSqrt2PiSigma * lateralTaper;
    sourceEta = waveSig * c;
    sourceW   = waveSig * _Gravity;
}

float ComputeSpongeDamping(int2 pos) {
    float distToBorder = min(min((float)pos.x, (float)(_Width - 1 - pos.x)), min((float)pos.y, (float)(_Height - 1 - pos.y)));
    if (distToBorder < _SpongeWidth) {
        float t = 1.0 - (distToBorder / _SpongeWidth);
        return 1.0 / (1.0 + t * t * _SpongeStrength * _DeltaTime * 15.0);
    }
    return 1.0;
}

[numthreads(8, 8, 1)]
void CSInit(uint3 id : SV_DispatchThreadID) {
    if (id.x >= (uint)_Width || id.y >= (uint)_Height) return;
    _StateOut[id.xy] = float4(0.0, 0.0, 0.0, 0.0);
    _NormalTex[id.xy] = float4(0.0, 1.0, 0.0, 0.0);
    _WaterDataTex[id.xy] = float4(0.0, 0.0, 0.0, 0.0);
    _ForceTex[id.xy] = float4(0.0, 0.0, 0.0, 0.0);
    _AccelPing[id.xy] = float4(0.0, 0.0, 0.0, 0.0);
    _AccelPong[id.xy] = float4(0.0, 0.0, 0.0, 0.0);
}

// 1. MacCormack Predictor: Forward spatial differences
[numthreads(8, 8, 1)]
void CSPredict(uint3 id : SV_DispatchThreadID) {
    if (id.x >= (uint)_Width || id.y >= (uint)_Height) return;
    int2 pos = int2(id.xy);

    int2 posR = int2(min(_Width - 1, pos.x + 1), pos.y);
    int2 posU = int2(pos.x, min(_Height - 1, pos.y + 1));

    float4 stateC = _StateIn[pos];
    float4 stateR = _StateIn[posR];
    float4 stateU = _StateIn[posU];

    float eta = stateC.r;
    float u   = stateC.g;
    float w   = stateC.b;

    float hC = max(0.2, _BathymetryTex[pos].r);
    float hR = max(0.2, _BathymetryTex[posR].r);
    float hU = max(0.2, _BathymetryTex[posU].r);

    float totalHC = max(0.05, hC + eta);
    float totalHR = max(0.05, hR + stateR.r);
    float totalHU = max(0.05, hU + stateU.r);

    float invDx = 1.0 / _GridSpacing;

    // Forward flux divergence: d(Hu)/dx + d(Hw)/dz
    float dHudx = (totalHR * stateR.g - totalHC * u) * invDx;
    float dHwdz = (totalHU * stateU.b - totalHC * w) * invDx;

    // Directional mass and momentum source
    float srcEta, srcW;
    GetWavemakerSources(pos, hC, _WavemakerPhase, srcEta, srcW);

    float etaPred = eta - _DeltaTime * (dHudx + dHwdz) + _DeltaTime * srcEta;

    // Forward spatial derivatives for momentum:
    float detadx = (stateR.r - eta) * invDx;
    float detadz = (stateU.r - eta) * invDx;

    float dudx = (stateR.g - u) * invDx;
    float dudz = (stateU.g - u) * invDx;
    float dwdx = (stateR.b - w) * invDx;
    float dwdz = (stateU.b - w) * invDx;

    float advectX = u * dudx + w * dudz;
    float advectZ = u * dwdx + w * dwdz;

    float friction = _BedFriction / totalHC;

    float fx = -_Gravity * detadx - advectX - friction * u;
    float fz = -_Gravity * detadz - advectZ - friction * w + srcW;

    _ForceTex[pos] = float4(fx, fz, 0.0, 0.0);

    float uPred = u + _DeltaTime * fx;
    float wPred = w + _DeltaTime * fz;

    float damp = ComputeSpongeDamping(pos);
    etaPred *= damp;
    uPred   *= damp;
    wPred   *= damp;

    etaPred = clamp(etaPred, -15.0, 15.0);
    uPred   = clamp(uPred,   -30.0, 30.0);
    wPred   = clamp(wPred,   -30.0, 30.0);

    _StatePred[pos] = float4(etaPred, uPred, wPred, 0.0);
}

// 2. MacCormack Corrector: Backward spatial differences + average with current state
[numthreads(8, 8, 1)]
void CSCorrect(uint3 id : SV_DispatchThreadID) {
    if (id.x >= (uint)_Width || id.y >= (uint)_Height) return;
    int2 pos = int2(id.xy);

    int2 posL = int2(max(0, pos.x - 1), pos.y);
    int2 posD = int2(pos.x, max(0, pos.y - 1));

    float4 stateN = _StateIn[pos];
    float4 statePredC = _StatePred[pos];
    float4 statePredL = _StatePred[posL];
    float4 statePredD = _StatePred[posD];

    float etaStar = statePredC.r;
    float uStar   = statePredC.g;
    float wStar   = statePredC.b;

    float hC = max(0.2, _BathymetryTex[pos].r);
    float hL = max(0.2, _BathymetryTex[posL].r);
    float hD = max(0.2, _BathymetryTex[posD].r);

    float totalHC = max(0.05, hC + etaStar);
    float totalHL = max(0.05, hL + statePredL.r);
    float totalHD = max(0.05, hD + statePredD.r);

    float invDx = 1.0 / _GridSpacing;

    // Backward flux divergence on predicted state:
    float dHudxStar = (totalHC * uStar - totalHL * statePredL.g) * invDx;
    float dHwdzStar = (totalHC * wStar - totalHD * statePredD.b) * invDx;

    float nextPhase = _WavemakerPhase + 2.0 * 3.14159265 * _WavemakerFreq * _DeltaTime;
    float srcEtaStar, srcWStar;
    GetWavemakerSources(pos, hC, nextPhase, srcEtaStar, srcWStar);

    // MacCormack 2nd-order elevation update
    float etaNext = 0.5 * (stateN.r + etaStar - _DeltaTime * (dHudxStar + dHwdzStar) + _DeltaTime * srcEtaStar);

    // Backward spatial derivatives for momentum on predicted state:
    float detadxStar = (etaStar - statePredL.r) * invDx;
    float detadzStar = (etaStar - statePredD.r) * invDx;

    float dudxStar = (uStar - statePredL.g) * invDx;
    float dudzStar = (uStar - statePredD.g) * invDx;
    float dwdxStar = (wStar - statePredL.b) * invDx;
    float dwdzStar = (wStar - statePredD.b) * invDx;

    float advectXStar = uStar * dudxStar + wStar * dudzStar;
    float advectZStar = uStar * dwdxStar + wStar * dwdzStar;

    float frictionStar = _BedFriction / totalHC;

    float fxStar = -_Gravity * detadxStar - advectXStar - frictionStar * uStar;
    float fzStar = -_Gravity * detadzStar - advectZStar - frictionStar * wStar + srcWStar;

    float2 fPred = _ForceTex[pos].xy;
    float2 fAvg = 0.5 * (fPred + float2(fxStar, fzStar));

    _ForceTex[pos] = float4(fAvg, 0.0, 0.0);
    _AccelPing[pos] = float4(fAvg, 0.0, 0.0);

    float damp = ComputeSpongeDamping(pos);
    etaNext *= damp;
    etaNext = clamp(etaNext, -15.0, 15.0);

    if (_DispersionAlpha <= 0.001) {
        float uNext = 0.5 * (stateN.g + uStar + _DeltaTime * fxStar) * damp;
        float wNext = 0.5 * (stateN.b + wStar + _DeltaTime * fzStar) * damp;
        uNext = clamp(uNext, -30.0, 30.0);
        wNext = clamp(wNext, -30.0, 30.0);
        _StateOut[pos] = float4(etaNext, uNext, wNext, 0.0);
    } else {
        // Store etaNext and current velocities stateN.gb; CSApplyDispersion will finalize velocity update
        _StateOut[pos] = float4(etaNext, stateN.g, stateN.b, 0.0);
    }
}

// 3. Jacobi relaxation for Helmholtz dispersion inversion: (I - beta * Laplacian) a = f
[numthreads(8, 8, 1)]
void CSJacobiStep(uint3 id : SV_DispatchThreadID) {
    if (id.x >= (uint)_Width || id.y >= (uint)_Height) return;
    int2 pos = int2(id.xy);

    if (pos.x <= 1 || pos.x >= _Width - 2 || pos.y <= 1 || pos.y >= _Height - 2) {
        _AccelPong[pos] = float4(0.0, 0.0, 0.0, 0.0);
        return;
    }

    float h = max(0.2, _BathymetryTex[pos].r);
    float dx = _GridSpacing;
    float beta = _DispersionAlpha * (h * h) / (6.0 * dx * dx);
    beta = clamp(beta, 0.0, 4.0);

    float4 f = _ForceTex[pos];
    float4 aL = _AccelPing[pos + int2(-1, 0)];
    float4 aR = _AccelPing[pos + int2( 1, 0)];
    float4 aD = _AccelPing[pos + int2( 0,-1)];
    float4 aU = _AccelPing[pos + int2( 0, 1)];

    float2 sumNeighbors = aL.xy + aR.xy + aD.xy + aU.xy;
    float2 aNext = (f.xy + beta * sumNeighbors) / (1.0 + 4.0 * beta);

    _AccelPong[pos] = float4(aNext, 0.0, 0.0);
}

// 4. Apply Helmholtz-dispersed acceleration to velocity and apply sponge layer
[numthreads(8, 8, 1)]
void CSApplyDispersion(uint3 id : SV_DispatchThreadID) {
    if (id.x >= (uint)_Width || id.y >= (uint)_Height) return;
    int2 pos = int2(id.xy);

    float4 state = _StateOut[pos];
    float eta = state.r;
    float uN  = state.g;
    float wN  = state.b;

    float2 aEff = _AccelPing[pos].xy;
    float uNext = uN + _DeltaTime * aEff.x;
    float wNext = wN + _DeltaTime * aEff.y;

    float damp = ComputeSpongeDamping(pos);
    uNext *= damp;
    wNext *= damp;

    uNext = clamp(uNext, -30.0, 30.0);
    wNext = clamp(wNext, -30.0, 30.0);

    _StateOut[pos] = float4(eta, uNext, wNext, 0.0);
}

// 5. Surface normal and foam computation
[numthreads(8, 8, 1)]
void CSComputeNormal(uint3 id : SV_DispatchThreadID) {
    if (id.x >= (uint)_Width || id.y >= (uint)_Height) return;
    int2 pos = int2(id.xy);

    int l = max(0, pos.x - 1);
    int r = min(_Width - 1, pos.x + 1);
    int d = max(0, pos.y - 1);
    int u = min(_Height - 1, pos.y + 1);

    float hL = _StateOut[int2(l, pos.y)].r;
    float hR = _StateOut[int2(r, pos.y)].r;
    float hD = _StateOut[int2(pos.x, d)].r;
    float hU = _StateOut[int2(pos.x, u)].r;
    float hC = _StateOut[pos].r;

    float dx = 2.0 * _GridSpacing;
    float dhdx = (hR - hL) / dx;
    float dhdz = (hU - hD) / dx;

    float normalStrength = 2.0;
    float3 normal = normalize(float3(-dhdx * normalStrength, 1.0, -dhdz * normalStrength));

    float slope = length(float2(dhdx, dhdz));
    float foam = saturate((slope - 0.15) * 3.0);

    _NormalTex[pos] = float4(normal, foam);
    _WaterDataTex[pos] = float4(0.0, hC, 0.0, foam);
}
