#pragma kernel CSFilterX_Ref
#pragma kernel CSFilterZ_Ref
#pragma kernel CSFilterX_DirectLoad
#pragma kernel CSFilterZ_DirectLoad

Texture2D<float4> _StateIn;
RWTexture2D<float4> _StateOut;

cbuffer SimParams {
    int _Width;
    int _Height;
    float _DeltaTime;
    float _GridSpacing;
    float _GridSpacingZ;
    int _SideWallSponge;
};

struct FaceFlux3 {
    float3 f2;
    float3 f4;
};

struct CellRatio3 {
    float3 rp;
    float3 rm;
};

CellRatio3 InitCellRatio() {
    CellRatio3 r;
    r.rp = float3(1.0, 1.0, 1.0);
    r.rm = float3(1.0, 1.0, 1.0);
    return r;
}

float GetDx() {
    return max(1e-5, _GridSpacing);
}

float GetDz() {
    return (_GridSpacingZ > 1e-5) ? _GridSpacingZ : max(1e-5, _GridSpacing);
}

// -------------------------------------------------------------
// Reference implementation (identical to Boussinesq.compute)
// -------------------------------------------------------------

FaceFlux3 GetFaceFluxX_Ref(int i, int y) {
    FaceFlux3 res;
    res.f2 = float3(0.0, 0.0, 0.0);
    res.f4 = float3(0.0, 0.0, 0.0);
    int w = _Width;
    if (i < 0 || i >= w - 1) return res;

    float3 s_i   = _StateIn[int2(i, y)].xyz;
    float3 s_ip1 = _StateIn[int2(i + 1, y)].xyz;

    float dx = GetDx();
    float slopeX = abs(s_ip1.x - s_i.x) / dx;
    float excessSlopeX = max(0.0, slopeX - 0.40);
    float slopeWeightX = saturate(excessSlopeX * 3.0);
    float kappa2X = slopeWeightX * min(0.20, 30.0 * _DeltaTime);
    float kappa4X = min(0.058, 12.0 * _DeltaTime);

    res.f2 = -kappa2X * (s_ip1 - s_i);

    if (i == 0) {
        float3 s_2 = _StateIn[int2(2, y)].xyz;
        res.f4 = kappa4X * (2.0 * s_i - 3.0 * s_ip1 + s_2);
    } else if (i == w - 2) {
        float3 s_im1 = _StateIn[int2(w - 3, y)].xyz;
        res.f4 = kappa4X * (-s_im1 + 3.0 * s_i - 2.0 * s_ip1);
    } else {
        float3 s_im1 = _StateIn[int2(i - 1, y)].xyz;
        float3 s_ip2 = _StateIn[int2(i + 2, y)].xyz;
        res.f4 = kappa4X * (-s_im1 + 3.0 * s_i - 3.0 * s_ip1 + s_ip2);
    }
    return res;
}

CellRatio3 GetCellRatioX_Ref(int k, int y, FaceFlux3 fL, FaceFlux3 fR) {
    float3 s_k    = _StateIn[int2(k, y)].xyz;
    float3 s_prev = _StateIn[int2(max(0, k - 1), y)].xyz;
    float3 s_next = _StateIn[int2(min(_Width - 1, k + 1), y)].xyz;

    CellRatio3 r;
    [unroll]
    for (int ch = 0; ch < 3; ch++) {
        float v_L = s_k[ch] - (fR.f2[ch] - fL.f2[ch]);
        float v_min = min(s_k[ch], min(s_prev[ch], s_next[ch]));
        float v_max = max(s_k[ch], max(s_prev[ch], s_next[ch]));

        float p_plus  = max(0.0, -fR.f4[ch]) + max(0.0, fL.f4[ch]);
        float p_minus = max(0.0,  fR.f4[ch]) + max(0.0, -fL.f4[ch]);
        float q_plus  = max(0.0, v_max - v_L);
        float q_minus = max(0.0, v_L - v_min);

        r.rp[ch] = (p_plus > 1e-7) ? min(1.0, q_plus / p_plus) : 1.0;
        r.rm[ch] = (p_minus > 1e-7) ? min(1.0, q_minus / p_minus) : 1.0;
    }
    return r;
}

float3 LimitFlux3(FaceFlux3 f, CellRatio3 rL, CellRatio3 rR) {
    float3 fl;
    [unroll]
    for (int ch = 0; ch < 3; ch++) {
        float a = f.f4[ch];
        float c = (a > 0.0) ? min(rL.rm[ch], rR.rp[ch]) : min(rL.rp[ch], rR.rm[ch]);
        fl[ch] = f.f2[ch] + c * a;
    }
    return fl;
}

FaceFlux3 GetFaceFluxZ_Ref(int j, int x) {
    FaceFlux3 res;
    res.f2 = float3(0.0, 0.0, 0.0);
    res.f4 = float3(0.0, 0.0, 0.0);
    int h = _Height;
    if (j < 0 || j >= h - 1) return res;

    float3 s_j   = _StateIn[int2(x, j)].xyz;
    float3 s_jp1 = _StateIn[int2(x, j + 1)].xyz;

    float dz = GetDz();
    float slopeZ = abs(s_jp1.x - s_j.x) / dz;
    float excessSlopeZ = max(0.0, slopeZ - 0.40);
    float slopeWeightZ = saturate(excessSlopeZ * 3.0);
    float kappa2Z = slopeWeightZ * min(0.20, 30.0 * _DeltaTime);
    float kappa4Z = min(0.058, 12.0 * _DeltaTime);

    res.f2 = -kappa2Z * (s_jp1 - s_j);

    if (j == 0) {
        float3 s_2 = _StateIn[int2(x, 2)].xyz;
        res.f4 = kappa4Z * (2.0 * s_j - 3.0 * s_jp1 + s_2);
    } else if (j == h - 2) {
        float3 s_jm1 = _StateIn[int2(x, h - 3)].xyz;
        res.f4 = kappa4Z * (-s_jm1 + 3.0 * s_j - 2.0 * s_jp1);
    } else {
        float3 s_jm1 = _StateIn[int2(x, j - 1)].xyz;
        float3 s_jp2 = _StateIn[int2(x, j + 2)].xyz;
        res.f4 = kappa4Z * (-s_jm1 + 3.0 * s_j - 3.0 * s_jp1 + s_jp2);
    }
    return res;
}

CellRatio3 GetCellRatioZ_Ref(int k, int x, FaceFlux3 fD, FaceFlux3 fU) {
    float3 s_k    = _StateIn[int2(x, k)].xyz;
    float3 s_prev = _StateIn[int2(x, max(0, k - 1))].xyz;
    float3 s_next = _StateIn[int2(x, min(_Height - 1, k + 1))].xyz;

    CellRatio3 r;
    [unroll]
    for (int ch = 0; ch < 3; ch++) {
        float v_L = s_k[ch] - (fU.f2[ch] - fD.f2[ch]);
        float v_min = min(s_k[ch], min(s_prev[ch], s_next[ch]));
        float v_max = max(s_k[ch], max(s_prev[ch], s_next[ch]));

        float p_plus  = max(0.0, -fU.f4[ch]) + max(0.0, fD.f4[ch]);
        float p_minus = max(0.0,  fU.f4[ch]) + max(0.0, -fD.f4[ch]);
        float q_plus  = max(0.0, v_max - v_L);
        float q_minus = max(0.0, v_L - v_min);

        r.rp[ch] = (p_plus > 1e-7) ? min(1.0, q_plus / p_plus) : 1.0;
        r.rm[ch] = (p_minus > 1e-7) ? min(1.0, q_minus / p_minus) : 1.0;
    }
    return r;
}

[numthreads(8, 8, 1)]
void CSFilterX_Ref(uint3 id : SV_DispatchThreadID) {
    if (id.x >= (uint)_Width || id.y >= (uint)_Height) return;
    int2 pos = int2(id.xy);
    int x = pos.x;
    int y = pos.y;
    int w = _Width;

    FaceFlux3 f_m3 = GetFaceFluxX_Ref(x - 2, y);
    FaceFlux3 f_m1 = GetFaceFluxX_Ref(x - 1, y);
    FaceFlux3 f_p1 = GetFaceFluxX_Ref(x, y);
    FaceFlux3 f_p3 = GetFaceFluxX_Ref(x + 1, y);

    CellRatio3 r_m1 = (x > 0) ? GetCellRatioX_Ref(x - 1, y, f_m3, f_m1) : InitCellRatio();
    CellRatio3 r_0  = GetCellRatioX_Ref(x, y, f_m1, f_p1);
    CellRatio3 r_p1 = (x < w - 1) ? GetCellRatioX_Ref(x + 1, y, f_p1, f_p3) : InitCellRatio();

    if (x == 0) {
        r_m1.rp = float3(1.0, 1.0, 1.0);
        r_m1.rm = float3(1.0, 1.0, 1.0);
    }
    if (x == w - 1) {
        r_p1.rp = float3(1.0, 1.0, 1.0);
        r_p1.rm = float3(1.0, 1.0, 1.0);
    }

    float3 f_L = (x == 0)     ? float3(0.0, 0.0, 0.0) : LimitFlux3(f_m1, r_m1, r_0);
    float3 f_R = (x == w - 1) ? float3(0.0, 0.0, 0.0) : LimitFlux3(f_p1, r_0, r_p1);

    float3 filtered = _StateIn[pos].xyz - (f_R - f_L);
    if (_SideWallSponge == 0 && (x == 0 || x == w - 1)) {
        filtered.y = 0.0;
    }
    filtered.x = clamp(filtered.x, -15.0, 15.0);
    filtered.y = clamp(filtered.y, -30.0, 30.0);
    filtered.z = clamp(filtered.z, -30.0, 30.0);

    _StateOut[pos] = float4(filtered, 0.0);
}

[numthreads(8, 8, 1)]
void CSFilterZ_Ref(uint3 id : SV_DispatchThreadID) {
    if (id.x >= (uint)_Width || id.y >= (uint)_Height) return;
    int2 pos = int2(id.xy);
    int x = pos.x;
    int y = pos.y;
    int h = _Height;

    FaceFlux3 f_m3 = GetFaceFluxZ_Ref(y - 2, x);
    FaceFlux3 f_m1 = GetFaceFluxZ_Ref(y - 1, x);
    FaceFlux3 f_p1 = GetFaceFluxZ_Ref(y, x);
    FaceFlux3 f_p3 = GetFaceFluxZ_Ref(y + 1, x);

    CellRatio3 r_m1 = (y > 0) ? GetCellRatioZ_Ref(y - 1, x, f_m3, f_m1) : InitCellRatio();
    CellRatio3 r_0  = GetCellRatioZ_Ref(y, x, f_m1, f_p1);
    CellRatio3 r_p1 = (y < h - 1) ? GetCellRatioZ_Ref(y + 1, x, f_p1, f_p3) : InitCellRatio();

    if (y == 0) {
        r_m1.rp = float3(1.0, 1.0, 1.0);
        r_m1.rm = float3(1.0, 1.0, 1.0);
    }
    if (y == h - 1) {
        r_p1.rp = float3(1.0, 1.0, 1.0);
        r_p1.rm = float3(1.0, 1.0, 1.0);
    }

    float3 f_D = (y == 0)     ? float3(0.0, 0.0, 0.0) : LimitFlux3(f_m1, r_m1, r_0);
    float3 f_U = (y == h - 1) ? float3(0.0, 0.0, 0.0) : LimitFlux3(f_p1, r_0, r_p1);

    float3 filtered = _StateIn[pos].xyz - (f_U - f_D);
    if (y == 0 || y == h - 1) {
        filtered.z = 0.0;
    }
    filtered.x = clamp(filtered.x, -15.0, 15.0);
    filtered.y = clamp(filtered.y, -30.0, 30.0);
    filtered.z = clamp(filtered.z, -30.0, 30.0);

    _StateOut[pos] = float4(filtered, 0.0);
}

// -------------------------------------------------------------
// Candidate implementation (Preloads local values into registers)
// -------------------------------------------------------------

FaceFlux3 EvalFaceFluxFromStates(float3 s_L, float3 s_R, float3 s_LL, float3 s_RR, int faceIdx, int maxFaces, float gridD) {
    FaceFlux3 res;
    res.f2 = float3(0.0, 0.0, 0.0);
    res.f4 = float3(0.0, 0.0, 0.0);
    if (faceIdx < 0 || faceIdx >= maxFaces) return res;

    float slope = abs(s_R.x - s_L.x) / gridD;
    float excessSlope = max(0.0, slope - 0.40);
    float slopeWeight = saturate(excessSlope * 3.0);
    float kappa2 = slopeWeight * min(0.20, 30.0 * _DeltaTime);
    float kappa4 = min(0.058, 12.0 * _DeltaTime);

    res.f2 = -kappa2 * (s_R - s_L);
    if (faceIdx == 0) {
        res.f4 = kappa4 * (2.0 * s_L - 3.0 * s_R + s_RR);
    } else if (faceIdx == maxFaces - 1) {
        res.f4 = kappa4 * (-s_LL + 3.0 * s_L - 2.0 * s_R);
    } else {
        res.f4 = kappa4 * (-s_LL + 3.0 * s_L - 3.0 * s_R + s_RR);
    }
    return res;
}

CellRatio3 EvalCellRatioFromStates(float3 s_c, float3 s_prev, float3 s_next, FaceFlux3 fL, FaceFlux3 fR) {
    CellRatio3 r;
    [unroll]
    for (int ch = 0; ch < 3; ch++) {
        float v_L = s_c[ch] - (fR.f2[ch] - fL.f2[ch]);
        float v_min = min(s_c[ch], min(s_prev[ch], s_next[ch]));
        float v_max = max(s_c[ch], max(s_prev[ch], s_next[ch]));

        float p_plus  = max(0.0, -fR.f4[ch]) + max(0.0, fL.f4[ch]);
        float p_minus = max(0.0,  fR.f4[ch]) + max(0.0, -fL.f4[ch]);
        float q_plus  = max(0.0, v_max - v_L);
        float q_minus = max(0.0, v_L - v_min);

        r.rp[ch] = (p_plus > 1e-7) ? min(1.0, q_plus / p_plus) : 1.0;
        r.rm[ch] = (p_minus > 1e-7) ? min(1.0, q_minus / p_minus) : 1.0;
    }
    return r;
}

[numthreads(8, 8, 1)]
void CSFilterX_DirectLoad(uint3 id : SV_DispatchThreadID) {
    if (id.x >= (uint)_Width || id.y >= (uint)_Height) return;
    int x = (int)id.x;
    int y = (int)id.y;
    int w = _Width;

    // Direct fetch of 7 local stencil cells into registers
    float3 s_m3 = _StateIn[int2(clamp(x - 3, 0, w - 1), y)].xyz;
    float3 s_m2 = _StateIn[int2(clamp(x - 2, 0, w - 1), y)].xyz;
    float3 s_m1 = _StateIn[int2(clamp(x - 1, 0, w - 1), y)].xyz;
    float3 s_0  = _StateIn[int2(x, y)].xyz;
    float3 s_p1 = _StateIn[int2(clamp(x + 1, 0, w - 1), y)].xyz;
    float3 s_p2 = _StateIn[int2(clamp(x + 2, 0, w - 1), y)].xyz;
    float3 s_p3 = _StateIn[int2(clamp(x + 3, 0, w - 1), y)].xyz;

    float dx = GetDx();
    int maxFaces = w - 1;

    // Face fluxes f(x-2), f(x-1), f(x), f(x+1)
    FaceFlux3 f_m3 = EvalFaceFluxFromStates(s_m2, s_m1, s_m3, s_0,  x - 2, maxFaces, dx);
    FaceFlux3 f_m1 = EvalFaceFluxFromStates(s_m1, s_0,  s_m2, s_p1, x - 1, maxFaces, dx);
    FaceFlux3 f_p1 = EvalFaceFluxFromStates(s_0,  s_p1, s_m1, s_p2, x,     maxFaces, dx);
    FaceFlux3 f_p3 = EvalFaceFluxFromStates(s_p1, s_p2, s_0,  s_p3, x + 1, maxFaces, dx);

    CellRatio3 r_m1 = (x > 0) ? EvalCellRatioFromStates(s_m1, (x - 1 > 0 ? s_m2 : s_m1), s_0, f_m3, f_m1) : InitCellRatio();
    CellRatio3 r_0  = EvalCellRatioFromStates(s_0, (x > 0 ? s_m1 : s_0), (x < w - 1 ? s_p1 : s_0), f_m1, f_p1);
    CellRatio3 r_p1 = (x < w - 1) ? EvalCellRatioFromStates(s_p1, s_0, (x + 1 < w - 1 ? s_p2 : s_p1), f_p1, f_p3) : InitCellRatio();

    if (x == 0) {
        r_m1.rp = float3(1.0, 1.0, 1.0);
        r_m1.rm = float3(1.0, 1.0, 1.0);
    }
    if (x == w - 1) {
        r_p1.rp = float3(1.0, 1.0, 1.0);
        r_p1.rm = float3(1.0, 1.0, 1.0);
    }

    float3 f_L = (x == 0)     ? float3(0.0, 0.0, 0.0) : LimitFlux3(f_m1, r_m1, r_0);
    float3 f_R = (x == w - 1) ? float3(0.0, 0.0, 0.0) : LimitFlux3(f_p1, r_0, r_p1);

    float3 filtered = s_0 - (f_R - f_L);
    if (_SideWallSponge == 0 && (x == 0 || x == w - 1)) {
        filtered.y = 0.0;
    }
    filtered.x = clamp(filtered.x, -15.0, 15.0);
    filtered.y = clamp(filtered.y, -30.0, 30.0);
    filtered.z = clamp(filtered.z, -30.0, 30.0);

    _StateOut[int2(x, y)] = float4(filtered, 0.0);
}

[numthreads(8, 8, 1)]
void CSFilterZ_DirectLoad(uint3 id : SV_DispatchThreadID) {
    if (id.x >= (uint)_Width || id.y >= (uint)_Height) return;
    int x = (int)id.x;
    int y = (int)id.y;
    int h = _Height;

    // Direct fetch of 7 local stencil cells along Z into registers
    float3 s_m3 = _StateIn[int2(x, clamp(y - 3, 0, h - 1))].xyz;
    float3 s_m2 = _StateIn[int2(x, clamp(y - 2, 0, h - 1))].xyz;
    float3 s_m1 = _StateIn[int2(x, clamp(y - 1, 0, h - 1))].xyz;
    float3 s_0  = _StateIn[int2(x, y)].xyz;
    float3 s_p1 = _StateIn[int2(x, clamp(y + 1, 0, h - 1))].xyz;
    float3 s_p2 = _StateIn[int2(x, clamp(y + 2, 0, h - 1))].xyz;
    float3 s_p3 = _StateIn[int2(x, clamp(y + 3, 0, h - 1))].xyz;

    float dz = GetDz();
    int maxFaces = h - 1;

    FaceFlux3 f_m3 = EvalFaceFluxFromStates(s_m2, s_m1, s_m3, s_0,  y - 2, maxFaces, dz);
    FaceFlux3 f_m1 = EvalFaceFluxFromStates(s_m1, s_0,  s_m2, s_p1, y - 1, maxFaces, dz);
    FaceFlux3 f_p1 = EvalFaceFluxFromStates(s_0,  s_p1, s_m1, s_p2, y,     maxFaces, dz);
    FaceFlux3 f_p3 = EvalFaceFluxFromStates(s_p1, s_p2, s_0,  s_p3, y + 1, maxFaces, dz);

    CellRatio3 r_m1 = (y > 0) ? EvalCellRatioFromStates(s_m1, (y - 1 > 0 ? s_m2 : s_m1), s_0, f_m3, f_m1) : InitCellRatio();
    CellRatio3 r_0  = EvalCellRatioFromStates(s_0, (y > 0 ? s_m1 : s_0), (y < h - 1 ? s_p1 : s_0), f_m1, f_p1);
    CellRatio3 r_p1 = (y < h - 1) ? EvalCellRatioFromStates(s_p1, s_0, (y + 1 < h - 1 ? s_p2 : s_p1), f_p1, f_p3) : InitCellRatio();

    if (y == 0) {
        r_m1.rp = float3(1.0, 1.0, 1.0);
        r_m1.rm = float3(1.0, 1.0, 1.0);
    }
    if (y == h - 1) {
        r_p1.rp = float3(1.0, 1.0, 1.0);
        r_p1.rm = float3(1.0, 1.0, 1.0);
    }

    float3 f_D = (y == 0)     ? float3(0.0, 0.0, 0.0) : LimitFlux3(f_m1, r_m1, r_0);
    float3 f_U = (y == h - 1) ? float3(0.0, 0.0, 0.0) : LimitFlux3(f_p1, r_0, r_p1);

    float3 filtered = s_0 - (f_U - f_D);
    if (y == 0 || y == h - 1) {
        filtered.z = 0.0;
    }
    filtered.x = clamp(filtered.x, -15.0, 15.0);
    filtered.y = clamp(filtered.y, -30.0, 30.0);
    filtered.z = clamp(filtered.z, -30.0, 30.0);

    _StateOut[int2(x, y)] = float4(filtered, 0.0);
}
